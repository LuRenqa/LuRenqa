{
  "name": "dsh-ai-widget-hub",
  "version": "0.2.10",
  "description": "DSH 左侧栏 AI娘挂件中心（自包含版）：一个插件内置全部 9 只余额桌宠（DeepSeek/Gemini/Kimi/GLM/千问/Grok/Claude/GPT/MIMO），9 只均支持双形态；无需再安装其它挂件插件，左侧栏统一开关。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "catalog.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icons/*.png",
    "README.md",
    "widgets/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
